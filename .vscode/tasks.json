{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure (CMake)",
            "type": "shell",
            "command": ".\\configure.ps1",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": ".\\build.ps1",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "dependsOn": "Configure (CMake)"
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": ".\\test.ps1",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "dependsOn": "Build"
        },
        {
            "label": "Check Coverage",
            "type": "shell",
            "command": ".\\check_coverage.ps1",
            "group": "test",
            "problemMatcher": [],
            "dependsOn": "Build"
        }
    ]
}
